.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 20rpx;
}

.title-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sub-count {
  font-size: 24rpx;
  color: #888888;
  font-weight: normal;
}

.check-box {
  background-color: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 4rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.check-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.check-goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.check-sku {
  font-size: 22rpx;
  color: #777777;
}

.check-grid {
  display: grid;
  align-items: center;
  text-align: center;
  background-color: #ffffff;
  border: 1rpx solid #eeeeee;
  padding: 16rpx 0;
  border-radius: 4rpx;
}

/* 主管展示3列 */
.grid-three {
  grid-template-columns: 1fr 1fr 1fr;
}

/* 普通用户展示2列(删除盈亏结果列) */
.grid-two {
  grid-template-columns: 1fr 1fr;
}

.col {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.col-label {
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

/* 下方数值区域统一容器：严格垂直与水平居中 */
.col-value-box {
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.col-val {
  font-size: 28rpx;
  color: #444444;
  line-height: 56rpx;
}

.actual-input {
  border: 1rpx solid #1890ff;
  border-radius: 4rpx;
  width: 120rpx;
  height: 52rpx;
  min-height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  box-sizing: border-box;
  padding: 0;
}

.col-diff {
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
  line-height: 56rpx;
}

.text-green {
  color: #52c41a;
}

.text-red {
  color: #f5222d;
}

.remark-input-box {
  margin-top: 12rpx;
}

.form-input-sm {
  background-color: #ffffff;
  border: 1rpx solid #cccccc;
  border-radius: 4rpx;
  padding: 8rpx 14rpx;
  font-size: 24rpx;
}

.btn-submit {
  margin-top: 24rpx;
}

.arrow {
  color: #999999;
}
