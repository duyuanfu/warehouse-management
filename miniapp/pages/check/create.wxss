.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 20rpx;
}

.title-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sub-count {
  font-size: 24rpx;
  color: #888888;
  font-weight: normal;
}

.check-box {
  background-color: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 4rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.check-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.check-goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.check-sku {
  font-size: 22rpx;
  color: #777777;
}

/* 表格化两行布局：上面是表头，下面是数值行 */
.check-table {
  background-color: #ffffff;
  border: 1rpx solid #eeeeee;
  border-radius: 4rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.row-labels {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}

.cell-label {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #888888;
}

/* 核心数值行：Flex单行绝对水平垂直居中 */
.row-values {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  height: 56rpx;
}

.cell-val {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.num-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  line-height: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.actual-input {
  border: 2rpx solid #1890ff;
  border-radius: 4rpx;
  width: 130rpx;
  height: 52rpx;
  min-height: 52rpx !important;
  line-height: 52rpx !important;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background-color: #ffffff;
  color: #222222;
}

.text-green {
  color: #52c41a;
}

.text-red {
  color: #f5222d;
}

.remark-input-box {
  margin-top: 12rpx;
}

.form-input-sm {
  background-color: #ffffff;
  border: 1rpx solid #cccccc;
  border-radius: 4rpx;
  padding: 8rpx 14rpx;
  font-size: 24rpx;
}

.btn-submit {
  margin-top: 24rpx;
}

.arrow {
  color: #999999;
}
