.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 20rpx;
}

.title-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sub-count {
  font-size: 24rpx;
  color: #888888;
  font-weight: normal;
}

.check-box {
  background-color: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 4rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.check-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.check-goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.check-sku {
  font-size: 22rpx;
  color: #777777;
}

/* 表格化两行布局容器 */
.check-table-container {
  background-color: #ffffff;
  border: 1rpx solid #eeeeee;
  border-radius: 6rpx;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  width: 100%;
}

/* 通用行：严格单行横向排版，绝不换行 */
.table-row {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

/* 1. 表头行 */
.table-header-row {
  margin-bottom: 12rpx;
}

.table-col-header {
  flex: 1 1 0 !important;
  width: 0 !important;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
  white-space: nowrap;
}

/* 2. 数值行：统一固定高度，完全垂直居中 */
.table-value-row {
  height: 64rpx;
}

.table-col-value {
  flex: 1 1 0 !important;
  width: 0 !important;
  height: 64rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  box-sizing: border-box;
}

/* 数字文本：高度固定，单行垂直居中对齐 */
.val-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  height: 52rpx;
  line-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 输入框：固定高度，与左右文字中轴完全重合 */
.val-input {
  border: 2rpx solid #1890ff !important;
  border-radius: 6rpx !important;
  width: 130rpx !important;
  height: 52rpx !important;
  min-height: 52rpx !important;
  line-height: 52rpx !important;
  text-align: center !important;
  font-size: 28rpx !important;
  font-weight: bold !important;
  box-sizing: border-box !important;
  padding: 0 !important;
  margin: 0 !important;
  background-color: #ffffff !important;
  color: #222222 !important;
}

.text-green {
  color: #52c41a !important;
}

.text-red {
  color: #f5222d !important;
}

.remark-input-box {
  margin-top: 14rpx;
}

.form-input-sm {
  background-color: #ffffff;
  border: 1rpx solid #cccccc;
  border-radius: 4rpx;
  padding: 8rpx 14rpx;
  font-size: 24rpx;
}

.btn-submit {
  margin-top: 24rpx;
}

.arrow {
  color: #999999;
}
