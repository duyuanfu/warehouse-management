.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 20rpx;
}

.item-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-box {
  background-color: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 4rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.item-head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-num {
  font-size: 24rpx;
  color: #666666;
}

.btn-del {
  color: #f5222d;
  border-color: #ffa39e;
}

.stock-tip {
  font-size: 24rpx;
  color: #1890ff;
  margin-top: -8rpx;
  margin-bottom: 14rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.btn-submit {
  margin-top: 24rpx;
}

.arrow {
  color: #999999;
}
