/** app.wxss **/
page {
  background-color: #f0f2f5;
  font-family: Arial, "Microsoft YaHei", sans-serif;
  color: #333333;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 普通白色卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid #dddddd;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 普通按钮 */
.btn-primary {
  background-color: #1890ff;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 6rpx;
  text-align: center;
  padding: 18rpx 0;
}

.btn-primary:active {
  background-color: #096dd9;
}

.btn-secondary {
  background-color: #e8e8e8;
  color: #333333;
  font-size: 28rpx;
  border-radius: 6rpx;
  text-align: center;
  padding: 16rpx 0;
  border: 1rpx solid #cccccc;
}

.btn-sm {
  margin: 0;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
  border-radius: 4rpx;
  background-color: #f0f0f0;
  color: #333333;
  border: 1rpx solid #cccccc;
  line-height: 1.4;
}

/* 朴素标签 */
.badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid #cccccc;
}

.badge-normal {
  background-color: #f6ffed;
  color: #52c41a;
  border-color: #b7eb8f;
}

.badge-warning {
  background-color: #fff1f0;
  color: #f5222d;
  border-color: #ffa39e;
}

/* 表单通用 */
.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #444444;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  background-color: #ffffff;
  border: 1rpx solid #cccccc;
  border-radius: 4rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-picker {
  background-color: #ffffff;
  border: 1rpx solid #cccccc;
  border-radius: 4rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
  color: #333333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.empty-box {
  text-align: center;
  padding: 80rpx 0;
  color: #888888;
  font-size: 28rpx;
}
